# Set these in Vercel Project Settings > Environment Variables.
# Prefer a stable SearXNG endpoint; a public instance may rate-limit or disappear.
SEARXNG_URL=
# Optional paid fallback if you choose to use it.
TAVILY_API_KEY=
# Optional API gate. A static token in a browser extension is extractable,
# so this is only a basic barrier, not strong user authentication.
CITYMAIL_ACCESS_TOKEN=
