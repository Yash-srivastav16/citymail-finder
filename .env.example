# Optional client-side API base URL used when building the Chrome extension.
# This value is public and must not contain secrets.
VITE_API_BASE_URL=https://citymail-finder.vercel.app

# Configure a SearXNG instance URL in Vercel Project Settings > Environment Variables.
# SearXNG is the preferred search provider.
SEARXNG_URL=

# Optional fallback providers. Keep these unset if you want SearXNG only.
FREESEA_API_KEY=
TAVILY_API_KEY=

# Optional API gate. A static token in a browser extension is extractable,
# so this is only a basic barrier, not strong user authentication.
CITYMAIL_ACCESS_TOKEN=
