{
  "manifest_version": 3,
  "name": "CityMail Finder",
  "version": "1.1.2",
  "description": "Collect visible email matches from Google Search results by city. Manual CAPTCHA handling; email matches are unverified.",
  "permissions": [
    "unlimitedStorage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://www.google.com/search*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open CityMail Finder"
  },
  "icons": {
    "16": "icons/citymail-128.png",
    "32": "icons/citymail-128.png",
    "48": "icons/citymail-128.png",
    "128": "icons/citymail-128.png"
  }
}
