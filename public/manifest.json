{
  "manifest_version": 3,
  "name": "CityMail Finder",
  "version": "1.1.2",
  "description": "Automatically search multiple locations through the CityMail search API and collect unverified email matches.",
  "permissions": [
    "unlimitedStorage",
    "tabs"
  ],
  "host_permissions": [
    "https://citymail-finder.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open CityMail Finder"
  },
  "icons": {
    "16": "icons/citymail-128.png",
    "32": "icons/citymail-128.png",
    "48": "icons/citymail-128.png",
    "128": "icons/citymail-128.png"
  }
}
