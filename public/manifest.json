{
  "manifest_version": 3,
  "name": "CityMail Finder",
  "version": "1.1.0",
  "description": "Research business emails visible in Google results by city. Deduplicate and export addresses to Excel.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://www.google.com/search*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open CityMail Finder"
  }
}
